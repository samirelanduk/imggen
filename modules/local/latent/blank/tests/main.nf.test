nextflow_process {

    name "Test BLANK_LATENT"
    script "../main.nf"
    process "BLANK_LATENT"

    test("test_blank_latent") {

        when {
            process {
                """
                input[0] = [[id: "test"], 768, 512]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
            )
        }
    }
}
