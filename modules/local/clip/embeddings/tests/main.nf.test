nextflow_process {

    name "Test CLIP_EMBEDDINGS"
    script "../main.nf"
    process "CLIP_EMBEDDINGS"

    test("test_embeddings") {

        when {
            process {
                """
                input[0] = [[id: "test"], file("$projectDir/tests/data/tokens.json", checkIfExists: true)]
                input[1] = file("$projectDir/tests/data/test_model.safetensors", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
            )
        }
    }
}
