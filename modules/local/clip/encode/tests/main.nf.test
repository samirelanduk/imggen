nextflow_process {

    name "Test CLIP_ENCODE"
    script "../main.nf"
    process "CLIP_ENCODE"

    test("test_encode") {

        when {
            process {
                """
                input[0] = [[id: "test"], file("$projectDir/tests/data/embedding.pt", checkIfExists: true)]
                input[1] = file("$projectDir/tests/data/clip_encode_model.safetensors", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
            )
        }
    }
}
