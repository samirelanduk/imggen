nextflow_process {

    name "Test CLIP_TOKENIZE"
    script "../main.nf"
    process "CLIP_TOKENIZE"

    test("test_tokenize_short_prompt") {

        when {
            process {
                """
                input[0] = [[id: "A_photo_of"], "A photo of a cat, sat on a mat."]
                input[1] = file("${projectDir}/assets/clip_tokenizer")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
            )
        }
    }

    test("test_tokenize_long_prompt") {

        when {
            process {
                """
                def long_prompt = file("$moduleTestDir/long_input.txt").text.trim()
                input[0] = [[id: "a_vast_ancient"], long_prompt]
                input[1] = file("${projectDir}/assets/clip_tokenizer")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
            )
        }
    }
}