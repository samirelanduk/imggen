{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com///nextflow_schema.json",
  "title": "samirelanduk/nf-diffuser pipeline parameters",
  "description": "Image generation with stable diffusion.",
  "type": "object",
  "$defs": {
    "options": {
      "title": "Options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define input values for the pipeline.",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The positive prompt as a direct string.",
          "fa_icon": "fas fa-align-center"
        },
        "prompt_file": {
          "type": "string",
          "description": "Path to a text file containing the positive prompt.",
          "fa_icon": "fas fa-file-alt",
          "format": "file-path",
          "mimetype": "text/plain",
          "pattern": "^\\S+\\.txt$"
        },
        "model": {
          "type": "string",
          "description": "The model to use for image generation.",
          "fa_icon": "fas fa-file-alt",
          "format": "file-path",
          "mimetype": "application/octet-stream",
          "pattern": "^\\S+\\.safetensors$"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/options"
    }
  ]
}
