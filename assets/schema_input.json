{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/samirelanduk/nf-diffuser/master/assets/schema_input.json",
    "title": "samirelanduk/nf-diffuser pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "positive": {
                "type": "string",
                "errorMessage": "Positive prompt must be provided",
                "meta": ["positive"]
            },
            "negative": {
                "type": "string",
                "errorMessage": "Negative prompt must be provided",
                "meta": ["negative"]
            },
            "width": {
                "type": "integer",
                "errorMessage": "Width must be an integer",
                "meta": ["width"]
            },
            "height": {
                "type": "integer",
                "errorMessage": "Height must be an integer",
                "meta": ["height"]
            }
        },
        "required": ["sample", "positive", "negative"]
    }
}
